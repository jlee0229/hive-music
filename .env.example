# HiveMusic environment template. Nothing here is required to run locally: every variable has a
# working default (server on :8080, web on :3000, random room codes, rule-based vibe director).
# There are TWO env files, one per app, because each process reads its own working directory:
#
#   apps/server/.env        <- the "server" block below   (Bun loads it automatically)
#   apps/web/.env.local     <- the "web" block below      (Next.js loads it automatically)
#
# Both are gitignored. Never commit real keys. Production values are listed in docs/13-operations.md.

# ---- web: apps/web/.env.local ------------------------------------------------------------------
# NEXT_PUBLIC_* is baked into the browser bundle when `next dev`/`next build` STARTS:
# restart the web dev server after changing any of these.

# REST base URL of the room server.
NEXT_PUBLIC_API_URL=http://localhost:8080
# WebSocket endpoint of the room server.
NEXT_PUBLIC_WS_URL=ws://localhost:8080/ws
# Leave unset for the real Web Audio engine. "stub" swaps in the audio-less engine (used by e2e).
# NEXT_PUBLIC_HIVE_ENGINE=stub

# ---- server: apps/server/.env ------------------------------------------------------------------
# Port Bun.serve listens on. If 8080 is taken on your machine pick another (e.g. 8787) and point
# the two web URLs above at it.
PORT=8080
# Origin of the web app. The server builds the join URL returned by POST /rooms from it.
NEXT_PUBLIC_WEB_URL=http://localhost:3000
# Browser origin allowed by CORS. Unset means "*" (which is also what production runs today).
# CORS_ORIGIN=http://localhost:3000
# Vibe Director: with no key it uses the built-in rules (the default; production sets no key
# as of 2026-10).
# ANTHROPIC_API_KEY=
# VIBE_MODEL=claude-sonnet-5
# Where tracks live (the folder that contains tracks/). Default: <repo>/fixtures.
# FIXTURES_DIR=
# Hackathon-era demo switch: one fixed room that is re-created under the same code after a
# restart. Production does NOT set it (codes are random per hive). Leave it unset unless you are
# running the manual e2e specs in apps/web/e2e/manual, which expect it.
# ROOM_FIXED_CODE=BZQ7
