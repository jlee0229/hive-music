# HiveMusic environment template.
# Copy to `.env` (server) and/or `apps/web/.env.local` (web). Never commit real keys.

# ---- apps/web (NEXT_PUBLIC_* is baked into the browser bundle) ----
# REST base URL of the Bun server.
NEXT_PUBLIC_API_URL=http://localhost:8080
# WebSocket endpoint of the Bun server.
NEXT_PUBLIC_WEB_URL=http://localhost:3000   # the server builds joinUrl from this
NEXT_PUBLIC_WS_URL=ws://localhost:8080/ws

# ---- apps/server ----
# Port Bun.serve listens on (Fly sets 8080 via infra/fly.toml).
PORT=8080
# Claude model used by the Vibe Director (one structured-output call per vibe prompt).
VIBE_MODEL=claude-sonnet-5
# Console API key for the Vibe Director; leave empty to use the rule-based fallback.
ANTHROPIC_API_KEY=
# Replicate token for the stretch "upload your own file" Demucs path; leave empty to disable.
REPLICATE_API_TOKEN=
# Fixed demo room code accepted by POST /rooms {code} so the QR/URL never changes.
ROOM_FIXED_CODE=BZQ7
# Browser origin allowed by CORS on /health, /rooms, /tracks and /audio.
CORS_ORIGIN=http://localhost:3000
