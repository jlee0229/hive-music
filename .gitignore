# dependencies
node_modules

# build output
.next
dist
.turbo
*.tsbuildinfo
next-env.d.ts

# env / secrets: every .env file is local-only. The template is the one exception.
.env
.env.*
!.env.example

# deploy tooling state (Vercel project/org ids, pulled env)
.vercel

# Tracks: this repo is public. Only the two generated fixtures are tracked (their meta.json; the
# WAVs are regenerated by `bun run fixtures`). Every other folder under fixtures/tracks is a song
# somebody uploaded to a local server: its audio AND its metadata stay out of git.
fixtures/tracks/*
!fixtures/tracks/synthetic-60s/
!fixtures/tracks/synthetic-30s-lite/
*.wav
*.mp3
*.m4a
*.flac
*.ogg

# large generated media
evidence/**/*.mp4
evidence/**/*.webm

# os
.DS_Store
Thumbs.db

# local tooling (machine-specific launch config, cloudflared quick-tunnel logs)
.claude/
.tunnels/
*.log

# playwright
apps/web/test-results
apps/web/playwright-report
apps/web/blob-report
apps/web/playwright/.cache

# the hackathon pitch deck is kept outside the repo
presentation/
